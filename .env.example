# Variáveis de ambiente — Kurio NFT Marketplace
# Mocks REST (MSW) e Socket.IO ativos por padrão (incluso em build de produção)
VITE_ENABLE_MOCKS=true

# Exibe o botão flutuante "Cenários" na interface para controle manual de cenários
VITE_SHOW_MOCK_PANEL=false

# Prefixo da API REST
VITE_API_URL=/api
